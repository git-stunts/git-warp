  "scenarios": [
    {
      "graph": "golden",
      "classification": "golden",
      "description": "Lane writers alice and bob write nodes, edges, properties and an entity. Alice forks strand `review`, which writes the checkpoint, then writes to the strand and settles it back into the lane. No duplicate dots.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice",
          "bob",
          "@w.alice@s.{review}"
        ]
      }
    },
    {
      "graph": "braided",
      "classification": "edge-case",
      "description": "Owned strands `support` and `main-work`, where `main-work` braids `support`. The braid pin and the support overlay head are the same commit.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice",
          "@w.alice@s.{main-work}",
          "@w.alice@s.{support}"
        ]
      }
    },
    {
      "graph": "collision",
      "classification": "edge-case",
      "description": "Lane writer `next` and alice-owned strand `next` both mint the legacy dot `next:1`. After re-keying, the lane dot stays `next` and the strand dot becomes `@w.alice@s.{next}`, so the duplicate scan must run on resolved identities.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice",
          "next",
          "@w.alice@s.{next}"
        ]
      }
    },
    {
      "graph": "collision-remove",
      "classification": "edge-case",
      "description": "Lane writer `next` mints next:1. Alice forks strand `next`; its overlay mints next:2 and next:3, then removes lane:1 (observing the lane dot next:1) and strand:2 (observing its own next:3). The migration must resolve each reference by origin: next:1 stays a lane dot, while next:2 and next:3 are re-keyed.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice",
          "next",
          "@w.alice@s.{next}"
        ]
      }
    },
    {
      "graph": "dotted-ids",
      "classification": "edge-case",
      "description": "Writer `ops.bot-1` owns strand `rel.v2`. `.` is legal in legacy ids and is also the sigil separator.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "ops.bot-1",
          "@w.ops.bot-1@s.{rel.v2}"
        ]
      }
    },
    {
      "graph": "counter-reset",
      "classification": "known-failure",
      "description": "Alice adds 100 nodes in one session, then a restarted session mints alice:1 again. The head context says alice -> 1, so a mint seeded from the head alone would issue alice:2, which already exists. The migration must establish an allocation floor of 100 (#1021) and report the duplicate.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice"
        ],
        "damage": [
          "duplicate-dot"
        ],
        "allocationFloors": {
          "alice": 100
        }
      }
    },
    {
      "graph": "dot-reuse",
      "classification": "known-failure",
      "description": "Two alice sessions each mint `alice:1`, and both add sites are live. The migration keeps the interpretation unchanged and reports the duplicate. Repair is a separate operation (#1022).",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice"
        ],
        "damage": [
          "duplicate-dot"
        ],
        "allocationFloors": {
          "alice": 1
        }
      }
    },
    {
      "graph": "dot-reuse-tombstone",
      "classification": "known-failure",
      "description": "The same reuse, followed by a remove of note:drop. The remove observes the shared dot `alice:1`, so v19.1.0 also hides note:keep. The migration preserves that visible state and reports both the duplicate and the collateral deletion.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice"
        ],
        "damage": [
          "duplicate-dot",
          "collateral-deletion"
        ],
        "allocationFloors": {
          "alice": 1
        }
      }
    },
    {
      "graph": "ownerless",
      "classification": "known-failure",
      "description": "Strand `orphan` was created through the internal createStrand with no owner. The migration refuses unless the operator assigns one.",
      "proposedMigration": {
        "verdict": "refuse",
        "refusal": "ownerless-strand",
        "mints": [
          "alice"
        ]
      }
    },
    {
      "graph": "shared-dot-strand-remove",
      "classification": "known-failure",
      "description": "Two alice sessions each mint alice:1 (note:keep, note:drop). Bob forks strand `cleanup` and removes note:drop; the remove observes the shared alice:1, so the strand view loses note:keep as well while the lane keeps both. The migration preserves the strand-local collateral deletion and reports it. A translated remove tombstones every identity its legacy dot denoted in the remove's view.",
      "proposedMigration": {
        "verdict": "migrate",
        "mints": [
          "alice",
          "@w.bob@s.{cleanup}"
        ],
        "damage": [
          "duplicate-dot",
          "collateral-deletion"
        ],
        "allocationFloors": {
          "alice": 1
        }
      }
    }
  ]
